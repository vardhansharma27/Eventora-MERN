MONGO_URI=
JWT_SECRET=supersecretjwtkey_eventora
PORT=5000

# Email — Brevo for production (Render), Gmail for local dev
# Brevo: https://www.brevo.com → SMTP & API → SMTP key
BREVO_SMTP_USER=b0cd1d001@smtp-brevo.com
BREVO_SMTP_KEY=your-brevo-smtp-key
# Must be a sender verified in Brevo → Senders & IP → Senders (NOT the @smtp-brevo.com login)
BREVO_SENDER_EMAIL=your-verified@gmail.com

# Gmail fallback (works locally; often blocked on cloud servers)
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_gmail_app_password

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
